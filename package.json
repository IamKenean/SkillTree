{
  "name": "ascend-skill-tree",
  "version": "1.0.0",
  "description": "Ascend, an AI-powered adaptive skill tree platform for personal growth.",
  "type": "module",
  "main": "dist-server/index.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite --host 0.0.0.0",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamKenean/SkillTree.git"
  },
  "keywords": [
    "skill-tree",
    "react-flow",
    "personal-growth",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IamKenean/SkillTree/issues"
  },
  "homepage": "https://github.com/IamKenean/SkillTree#readme",
  "dependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "morgan": "^1.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.0.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.8.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.0",
    "vitest": "^4.1.6"
  }
}
