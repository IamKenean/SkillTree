{
  "name": "skilltree",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamKenean/SkillTree.git"
  },
  "bugs": {
    "url": "https://github.com/IamKenean/SkillTree/issues"
  },
  "homepage": "https://github.com/IamKenean/SkillTree#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
